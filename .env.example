# ── Backend ──────────────────────────────────────────────────────────────
# Host port that maps to the backend container (internal port stays 5000)
SERVER_PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret

# ── Frontend ─────────────────────────────────────────────────────────────
# Host port that maps to the nginx container (internal port stays 80)
CLIENT_PORT=3000

# URL the browser uses for the Socket.IO/API connection.
# Leave EMPTY to use same-origin through nginx (recommended for compose).
# Set e.g. http://localhost:5000 only if the client should bypass nginx.
REACT_APP_SERVER_URL=
